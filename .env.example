# PHAROS: environment variable NAMES only. Never put a real value in this file or in git.
# The real values are pasted once into GitHub → Settings → Secrets and variables → Actions (docs/setup.md).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string (IPv4); the collectors, backups and the Vault step use it
SUPABASE_DB_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Cloudflare R2 archive (when absent, the collectors archive to ./.archive/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pharos-archive
CLOUDFLARE_API_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# optional: without it the watchdog uses the first admin's linked Telegram chat
ADMIN_TELEGRAM_CHAT_ID=

# The PV mailbox, read over IMAP for the Fimea and TGA newsletters
PHAROS_IMAP_HOST=
PHAROS_IMAP_PORT=993
PHAROS_IMAP_USER=pharos@satopharma.com
PHAROS_IMAP_PASSWORD=

# GitHub (probe-source). In GitHub secrets this one is named DISPATCH_TOKEN: GitHub does not allow
# secret names that start with GITHUB_. The deploy copies it into the function as GITHUB_DISPATCH_TOKEN.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=

# PubMed (phase 2)
NCBI_API_KEY=

# Edge Functions (set by the deploy, not by hand)
SITE_URL=
CONTACT_EMAIL=pharos@satopharma.com
ALLOWED_ORIGINS=

# Optional email Worker only
PV_MAILBOX=pharos@satopharma.com
