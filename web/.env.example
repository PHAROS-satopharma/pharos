# Copy to web/.env.local for a local run. Cloudflare Pages sets these in the project settings.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# The Telegram bot's username, without the @ (used for the Connect Telegram deep link).
VITE_TELEGRAM_BOT_USERNAME=<bot_username>
